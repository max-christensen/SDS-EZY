{
  "name": "sds-ezy",
  "version": "1.0.0",
  "private": true,
  "description": "A chemical register with a hazard risk assessment for each chemical, drafted from an uploaded safety data sheet. Runs entirely on Cloudflare (Workers, D1, R2).",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "vendor": "node scripts/vendor.mjs",
    "deploy": "npm run db:init && wrangler deploy",
    "db:init": "wrangler d1 execute DB --remote --yes --file=./schema.sql",
    "db:init:local": "wrangler d1 execute DB --local --file=./schema.sql",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "demo:build": "node scripts/make-demo.mjs",
    "demo:seed:local": "node scripts/seed-demo-local.mjs",
    "answer-key": "node scripts/answer-key.mjs",
    "answer-key:selftest": "node scripts/answer-key.mjs --self-test",
    "predeploy": "node scripts/bump-version.mjs",
    "check:version": "node scripts/bump-version.mjs --check",
    "make:icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "^2.0.4",
    "read-excel-file": "^9.3.12",
    "wrangler": "^4.0.0",
    "write-excel-file": "^4.1.1"
  }
}
